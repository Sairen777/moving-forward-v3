{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!src/backgrounds/quiet-field/profile.ts",
      "!src/backgrounds/quiet-field/background.module.css",
      "!**/.impeccable"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "assist": {
    "enabled": true,
    "actions": {
      "recommended": false,
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [
                ":PACKAGE:",
                ":PACKAGE_WITH_PROTOCOL:",
                ":NODE:",
                ":BUN:",
                ":URL:",
                ":ALIAS:",
                ":PATH:",
                "!**/*.css",
                "!**/*.css\\?*"
              ],
              ":BLANK_LINE:",
              ["**/*.css", "**/*.css\\?*"]
            ]
          }
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
